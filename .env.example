# Supabase — copy this to .env.local and fill in your project values
# Get these from: https://app.supabase.com → your project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server-only — used only in scripts and server-side API routes
# Never use NEXT_PUBLIC_ prefix; never import in client components
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# The app's public address, used in sign-in and invite links (for example https://behaviorlogger.example).
# Add it, with /**, to Supabase → Authentication → URL Configuration → Redirect URLs.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Demo mode ("Continue without saving" on login) is always on in dev.
# Set to 1 only to allow it in a production build, e.g. a preview deploy.
# NEXT_PUBLIC_ENABLE_DEMO=1
